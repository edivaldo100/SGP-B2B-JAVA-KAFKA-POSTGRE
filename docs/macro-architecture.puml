@startuml SGP-B2B Macro Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1a1a2e
skinparam roundCorner 10

skinparam rectangle {
  BorderThickness 2
  FontSize        10
}
skinparam package {
  BorderThickness 2
  FontStyle       bold
  FontSize        11
}
skinparam database {
  BorderColor     #2e7d32
  BackgroundColor #e8f5e9
  FontColor       #1a1a2e
  FontSize        10
}
skinparam queue {
  BorderColor     #e65100
  BackgroundColor #fff3e0
  FontColor       #1a1a2e
  FontSize        10
}
skinparam arrow {
  Color           #455a64
  FontSize        9
  FontColor       #455a64
}

' ════════════════════════════════════════════════════════════
'  LINHA 1 — Clientes
' ════════════════════════════════════════════════════════════
package "Clientes B2B" as C1 #f9fbe7 {
  rectangle "Parceiro A\n(ERP / Sistema)" as PA #dcedc8
  rectangle "Parceiro B\n(E-commerce)"   as PB #dcedc8
  rectangle "Parceiro C\n(Mobile App)"   as PC #dcedc8
  rectangle "K6\nLoad Test"              as K6 #fff9c4
  rectangle "Browser\n(Dashboard)"       as BR #e8f5e9
}

' ════════════════════════════════════════════════════════════
'  LINHA 2 — Edge
' ════════════════════════════════════════════════════════════
package "Edge · :80" as C2 #e8eaf6 {
  rectangle "Nginx · API Gateway\n──────────\nRouting · Proxy Reverso\nSSE sem buffer\nSub-path Grafana" as GW #c5cae9
}

' ════════════════════════════════════════════════════════════
'  LINHA 3 — Serviços
' ════════════════════════════════════════════════════════════
package "Serviços" as C3 #e3f2fd {
  rectangle "**Orders + Partners API**\n──────────\nJava 21 · Spring Boot 3.3.6\nVirtual Threads\nArquitetura Hexagonal\n/api/v1/orders\n/api/v1/partners\n/api/v1/orders/stream (SSE)" as API_ORDERS #bbdefb
  rectangle "Dashboard UI\n──────────\nReact 18 + Vite 5\nHistórico em tempo real\nGrafana iframe\n/dashboard/" as DASH #c8e6c9
  rectangle "Grafana 10.4\n──────────\nDashboard K6 #2587\n/grafana/"  as GRAF #e1bee7
}

' ════════════════════════════════════════════════════════════
'  LINHA 4 — Mensageria
' ════════════════════════════════════════════════════════════
package "Mensageria" as C4 #fff3e0 {
  queue "Apache Kafka 3.8\n(KRaft · sem Zookeeper)\n:9092\n──────────\norder.events.*" as KAFKA
}

' ════════════════════════════════════════════════════════════
'  LINHA 5 — Persistência
' ════════════════════════════════════════════════════════════
package "Persistência" as C5 #e8f5e9 {
  database "PostgreSQL 16\n:5432\n──────────\norders · order_items\npartners · partner_credit\nidempotency_keys\noutbox_events" as PG
  database "InfluxDB 1.8\n:8086 · db=k6\n──────────\nmétricas K6" as INFLUX
}

' ════════════════════════════════════════════════════════════
'  LINHA 6 — Padrões internos
' ════════════════════════════════════════════════════════════
package "Padrões · Orders API" as C6 #fafafa {
  together {
    rectangle "Hexagonal\nPorts & Adapters" as PAT1 #f5f5f5
    rectangle "Idempotência\nKey + SHA-256\nTTL 30s"  as PAT2 #f5f5f5
    rectangle "Outbox\nSKIP LOCKED\nBackoff 30s×2ⁿ" as PAT3 #f5f5f5
    rectangle "Pessimistic Lock\nSELECT FOR UPDATE\npartner_credit" as PAT4 #f5f5f5
    rectangle "SSE\nApplicationEvent\nSseEmitter" as PAT5 #f5f5f5
  }
}

' ════════════════════════════════════════════════════════════
'  SETAS
' ════════════════════════════════════════════════════════════
PA --> GW : HTTPS
PB --> GW : HTTPS
PC --> GW : HTTPS
K6 --> GW : HTTP
BR --> GW : HTTP

GW --> API_ORDERS : /api/
GW --> DASH       : /dashboard/
GW --> GRAF       : /grafana/

API_ORDERS --> KAFKA  : Outbox Relay
KAFKA      --> API_ORDERS : (consumidores futuros)

API_ORDERS --> PG     : JPA + Flyway

K6     --> INFLUX : --out influxdb
INFLUX --> GRAF   : datasource

API_ORDERS .. PAT1
API_ORDERS .. PAT2
API_ORDERS .. PAT3
API_ORDERS .. PAT4
API_ORDERS .. PAT5

@enduml
