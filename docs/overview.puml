@startuml SGP-B2B Overview
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam nodesep 30
skinparam ranksep 50

skinparam actor {
  BorderColor     #4527a0
  BackgroundColor #ede7f6
  FontColor       #1a1a2e
}
skinparam node {
  BorderColor     #37474f
  BackgroundColor #eceff1
  FontColor       #1a1a2e
  FontStyle       bold
}
skinparam component {
  BorderColor     #1565c0
  BackgroundColor #e3f2fd
  FontColor       #1a1a2e
}
skinparam queue {
  BorderColor     #e65100
  BackgroundColor #fff3e0
  FontColor       #1a1a2e
}
skinparam database {
  BorderColor     #2e7d32
  BackgroundColor #e8f5e9
  FontColor       #1a1a2e
}
skinparam arrow {
  Color           #455a64
  FontColor       #455a64
  FontSize        9
}

actor "Parceiro B2B" as partner
actor "K6 Load Test"  as k6
actor "Browser\n(Dashboard)" as browser

node "SGP-B2B (Docker Compose)" #f5f5f5 {

  node "Edge :80 (único ponto de entrada)" as edge #e8eaf6 {
    [API Gateway · Nginx] #c5cae9
  }

  node "Orders API (app:8080)" as app #e3f2fd {
    [OrderController\nPartnerController]      #bbdefb
    [CreateOrderService\nUpdateOrderStatus]   #bbdefb
    [PartnerService]                          #bbdefb
    [OutboxPublisher]                         #bbdefb
    [OrderSseService\n@AFTER_COMMIT SSE]      #bbdefb
    [KafkaSseService\nKafkaConfirmedEvent SSE] #bbdefb
  }

  node "Dashboard (dashboard:80)" as dash #e8f5e9 {
    [React + Vite\nHistórico · Eventos Kafka\nGerenciamento · Grafana\n/dashboard/] #c8e6c9
  }

  node "Mensageria" as msg #fff3e0 {
    queue [Apache Kafka :9092\norder.events.*] #ffccbc
  }

  database "PostgreSQL :5432" as pg #e8f5e9 {
    [orders · order_items]    #c8e6c9
    [partners · partner_credit] #c8e6c9
    [idempotency_keys]        #c8e6c9
    [outbox_events]           #c8e6c9
  }

  node "Observabilidade" as obs #fff8e1 {
    [Grafana /grafana/] #ffe082
    [InfluxDB :8086]    #fff9c4
  }

}

partner --> [API Gateway · Nginx]          : HTTP :80
k6      --> [API Gateway · Nginx]          : HTTP :80 (load test)
browser --> [API Gateway · Nginx]          : HTTP :80

[API Gateway · Nginx]  --> [OrderController\nPartnerController]        : /api/
[API Gateway · Nginx]  --> [React + Vite\nHistórico · Eventos Kafka\nGerenciamento · Grafana\n/dashboard/] : /dashboard/
[API Gateway · Nginx]  --> [Grafana /grafana/]                         : /grafana/

[OrderController\nPartnerController]  --> [CreateOrderService\nUpdateOrderStatus]
[OrderController\nPartnerController]  --> [PartnerService]
[CreateOrderService\nUpdateOrderStatus] --> [orders · order_items]
[CreateOrderService\nUpdateOrderStatus] --> [partners · partner_credit]
[CreateOrderService\nUpdateOrderStatus] --> [idempotency_keys]
[CreateOrderService\nUpdateOrderStatus] --> [outbox_events]
[CreateOrderService\nUpdateOrderStatus] --> [OrderSseService\n@AFTER_COMMIT SSE] : SSE broadcast
[PartnerService]      --> [partners · partner_credit]

[OutboxPublisher]     --> [outbox_events]                 : FOR UPDATE SKIP LOCKED
[OutboxPublisher]     --> [Apache Kafka :9092\norder.events.*]  : send().get(5s)
[OutboxPublisher]     --> [KafkaSseService\nKafkaConfirmedEvent SSE] : KafkaConfirmedEvent

k6               --> [InfluxDB :8086]   : --out influxdb
[InfluxDB :8086] --> [Grafana /grafana/] : datasource

browser --> [OrderSseService\n@AFTER_COMMIT SSE]      : EventSource /orders/stream
browser --> [KafkaSseService\nKafkaConfirmedEvent SSE] : EventSource /orders/kafka/stream

@enduml
