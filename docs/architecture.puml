@startuml SGP-B2B Architecture

!theme plain
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 55
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor #FAFAFA
skinparam defaultFontColor #1a1a2e

skinparam package {
  BorderColor      #4a6fa5
  BackgroundColor  #f0f4ff
  FontColor        #1a1a2e
  FontStyle        bold
  FontSize         12
  BorderThickness  2
}
skinparam component {
  BorderColor      #4a6fa5
  BackgroundColor  #dce8ff
  FontColor        #1a1a2e
  FontSize         10
}
skinparam interface {
  BorderColor      #e07b39
  BackgroundColor  #fff3eb
  FontColor        #1a1a2e
  FontSize         10
}
skinparam database {
  BorderColor      #2e7d32
  BackgroundColor  #e8f5e9
  FontColor        #1a1a2e
  FontSize         10
}
skinparam queue {
  BorderColor      #c04000
  BackgroundColor  #fff0e6
  FontColor        #1a1a2e
  FontSize         10
}
skinparam actor {
  BorderColor      #6a0080
  BackgroundColor  #f3e5f5
  FontColor        #1a1a2e
}
skinparam arrow {
  Color            #4a6fa5
  FontSize         9
  FontColor        #333333
}
skinparam note {
  BorderColor      #9e9e9e
  BackgroundColor  #f5f5f5
  FontColor        #444444
  FontSize         9
}

' ═══════════════════════════════════════════════════════
'  ATORES
' ═══════════════════════════════════════════════════════
actor "Parceiro / Cliente" as CLIENT
actor "K6 Load Test"       as K6
actor "Browser Dashboard"  as BROWSER

' ═══════════════════════════════════════════════════════
'  EDGE
' ═══════════════════════════════════════════════════════
package "Edge · Nginx :80" as PKG_EDGE {
  component "API Gateway\nRouting · Proxy Reverso\nSSE sem buffer" as GW
}

' ═══════════════════════════════════════════════════════
'  ADAPTER IN — Web
' ═══════════════════════════════════════════════════════
package "Adapter IN · Web" as PKG_WEB {
  component "OrderController" as CTRL
  note right of CTRL
    POST   /api/v1/orders
    PATCH  /api/v1/orders/{id}/status
    DELETE /api/v1/orders/{id}
    GET    /api/v1/orders/{id}
    GET    /api/v1/orders  (filtros opcionais)
    GET    /api/v1/orders/stream  (SSE)
    ──────────────────────────────
    Headers: X-Partner-Id · Idempotency-Key
    Erros: RFC 9457 ProblemDetail
  end note

  component "PartnerController" as PCTRL
  note right of PCTRL
    POST /api/v1/partners
    GET  /api/v1/partners
  end note

  component "OrderSseService\nSseEmitter pool\n@EventListener" as SSE
}

' ═══════════════════════════════════════════════════════
'  CAMADA DE APLICAÇÃO
' ═══════════════════════════════════════════════════════
package "Application · Use Cases" as PKG_APP {

  component "CreateOrderService" as SVC_CREATE
  note right of SVC_CREATE
    TX1: INSERT idempotency PROCESSING
    TX2: SELECT FOR UPDATE partner_credit
    └─ Debita crédito
    └─ Salva Order (PENDENTE)
    └─ Salva OutboxEvent
    └─ markDone idempotency
    └─ publishEvent(OrderCreatedEvent)
  end note

  component "UpdateOrderStatusService" as SVC_UPDATE
  note right of SVC_UPDATE
    Máquina de estados:
    PENDENTE → APROVADO
    APROVADO → EM_PROCESSAMENTO
    EM_PROCESSAMENTO → ENVIADO
    ENVIADO → ENTREGUE
    * → CANCELADO (libera crédito)
  end note

  component "FindOrderService\n(N+1 evitado: 1 query\npara todos os partners)" as SVC_FIND

  component "PartnerService" as SVC_PARTNER
  note right of SVC_PARTNER
    create(): valida unicidade de nome
    └─ salva Partner + PartnerCredit
       (limite R$100M por padrão)
    findAll()
  end note
}

' ═══════════════════════════════════════════════════════
'  DOMÍNIO
' ═══════════════════════════════════════════════════════
package "Domain · Model" as PKG_DOM {
  component "Order (Aggregate Root)\ncreate() · reconstitute()\napprove() · cancel()" as ORDER
  component "OrderItem\nsubtotal()" as ITEM
  component "Partner\nid (SERIAL) · partnerUuid\ncreate() · reconstitute()" as PARTNER
  component "PartnerCredit\nhasCredit() · debit() · release()\n[@Version — Optimistic Lock]" as CREDIT
  component "IdempotencyRecord\ncreateProcessing() · isDone()\nTTL 30s" as IDEM
  component "OutboxEvent\nMAX_RETRIES=5\nBackoff 30s×2ⁿ" as OUTBOX

  ORDER "1" *-down- "N" ITEM : contém
}

' ═══════════════════════════════════════════════════════
'  PORTS
' ═══════════════════════════════════════════════════════
package "Ports · Out" as PKG_PORTS {
  interface "OrderRepository"         as P_ORDER
  interface "PartnerRepository"       as P_PARTNER
  interface "PartnerCreditRepository" as P_CREDIT
  interface "IdempotencyRepository"   as P_IDEM
  interface "OutboxEventRepository"   as P_OUTBOX
}

' ═══════════════════════════════════════════════════════
'  ADAPTERS OUT — Persistence
' ═══════════════════════════════════════════════════════
package "Adapter OUT · JPA / Flyway 10" as PKG_JPA {
  component "OrderRepositoryAdapter"         as A_ORDER
  component "PartnerRepositoryAdapter"       as A_PARTNER
  component "PartnerCreditRepositoryAdapter" as A_CREDIT
  component "IdempotencyRepositoryAdapter"   as A_IDEM
  component "OutboxEventRepositoryAdapter\nFOR UPDATE SKIP LOCKED" as A_OUTBOX
}

' ═══════════════════════════════════════════════════════
'  ADAPTER OUT — Messaging
' ═══════════════════════════════════════════════════════
package "Adapter OUT · Messaging" as PKG_MSG {
  component "OutboxPublisher\n@Scheduled fixedDelay=1s\nbatch=50" as PUBLISHER
}

' ═══════════════════════════════════════════════════════
'  INFRA EXTERNA
' ═══════════════════════════════════════════════════════
database "PostgreSQL 16 :5432\norders · order_items\npartners · partner_credit\nidempotency_keys · outbox_events" as PG

queue "Apache Kafka 3.8 :9092\n(KRaft)\norder.events.*" as KAFKA

package "Observabilidade" as PKG_OBS {
  database "InfluxDB 1.8 :8086" as INFLUX
  component "Grafana 10.4\n/grafana/" as GRAFANA
}

' ═══════════════════════════════════════════════════════
'  RELACIONAMENTOS
' ═══════════════════════════════════════════════════════
CLIENT  --> GW : HTTP :80
K6      --> GW : HTTP :80
BROWSER --> GW : HTTP :80

GW --> CTRL  : /api/v1/orders
GW --> PCTRL : /api/v1/partners

CTRL  --> SVC_CREATE  : CreateOrderCommand
CTRL  --> SVC_UPDATE  : UpdateOrderStatusCommand
CTRL  --> SVC_FIND    : search / findById
CTRL  --> SSE         : subscribe()
PCTRL --> SVC_PARTNER : create / findAll

SVC_CREATE  --> ORDER   : Order.create()
SVC_CREATE  --> IDEM    : createProcessing
SVC_CREATE  --> CREDIT  : debit
SVC_CREATE  --> SSE     : publishEvent

SVC_UPDATE  --> ORDER   : approve / cancel
SVC_UPDATE  --> CREDIT  : release

SVC_FIND    --> P_ORDER   : search
SVC_FIND    --> P_PARTNER : findAll (1 query)

SVC_PARTNER --> P_PARTNER : save
SVC_PARTNER --> P_CREDIT  : save

SVC_CREATE --> P_ORDER  : save
SVC_CREATE --> P_CREDIT : findForUpdate
SVC_CREATE --> P_IDEM   : tryInsert / markDone
SVC_CREATE --> P_OUTBOX : save
SVC_UPDATE --> P_ORDER  : findById / save
SVC_UPDATE --> P_CREDIT : save

P_ORDER   ..|> A_ORDER
P_PARTNER ..|> A_PARTNER
P_CREDIT  ..|> A_CREDIT
P_IDEM    ..|> A_IDEM
P_OUTBOX  ..|> A_OUTBOX

A_ORDER   --> PG
A_PARTNER --> PG
A_CREDIT  --> PG
A_IDEM    --> PG
A_OUTBOX  --> PG

PUBLISHER --> A_OUTBOX : findPendingForUpdate\nmarkSent / markFailed
PUBLISHER --> KAFKA    : send(event)

K6     --> INFLUX  : --out influxdb
INFLUX --> GRAFANA : datasource

@enduml
