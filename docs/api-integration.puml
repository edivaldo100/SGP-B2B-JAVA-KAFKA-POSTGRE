@startuml SGP-B2B API Integration

!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam defaultFontColor #1a1a2e
skinparam roundCorner 8
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

skinparam participant {
  BorderColor     #1565c0
  BackgroundColor #e3f2fd
  FontColor       #1a1a2e
  FontSize        10
  FontStyle       bold
}

skinparam actor {
  BorderColor     #4527a0
  BackgroundColor #ede7f6
  FontColor       #1a1a2e
}

skinparam database {
  BorderColor     #2e7d32
  BackgroundColor #e8f5e9
  FontColor       #1a1a2e
}

skinparam queue {
  BorderColor     #e65100
  BackgroundColor #fff3e0
  FontColor       #1a1a2e
}

skinparam collections {
  BorderColor     #6a1b9a
  BackgroundColor #f3e5f5
  FontColor       #1a1a2e
}

skinparam note {
  BorderColor     #9e9e9e
  BackgroundColor #fafafa
  FontColor       #444444
  FontSize        9
}

skinparam divider {
  BorderColor     #90a4ae
  FontColor       #37474f
  FontSize        11
  FontStyle       bold
}

' ════════════════════════════════════
'  PARTICIPANTES
' ════════════════════════════════════
actor        "Parceiro B2B"          as PARTNER
actor        "Browser Dashboard"     as BROWSER
participant  "Nginx :80"             as GW      #c5cae9
participant  "Orders+Partners API"   as ORDERS  #bbdefb
database     "PostgreSQL :5432"      as PG      #c8e6c9
queue        "Kafka :9092"           as KAFKA   #ffe0b2
collections  "Notif. API (futuro)"   as NOTIFY  #e1bee7

' ════════════════════════════════════
'  FLUXO 1 — CRIAR PARCEIRO
' ════════════════════════════════════
== Fluxo 1 · Cadastrar Parceiro ==

PARTNER -> GW : POST /api/v1/partners\n{ "name": "...", "creditLimit": 50000 }
activate GW
GW -> ORDERS : roteia
activate ORDERS

note right of ORDERS
  creditLimit é opcional.
  Se omitido → R$ 100.000.000,00
end note

ORDERS -> PG : INSERT partners
ORDERS -> PG : INSERT partner_credit\n(creditLimit informado ou padrão)
PG --> ORDERS : commit
ORDERS --> GW : 201 Created { id, partnerUuid, name, createdAt }
GW --> PARTNER : 201 Created

deactivate ORDERS
deactivate GW

' ════════════════════════════════════
'  FLUXO 2 — CRIAR PEDIDO
' ════════════════════════════════════
== Fluxo 2 · Criar Pedido ==

PARTNER -> GW : POST /api/v1/orders\nHeaders: X-Partner-Id · Idempotency-Key\nBody: { items: [...] }
activate GW

GW -> ORDERS : roteia
activate ORDERS

note right of ORDERS
  SHA-256(body) = requestHash
end note

' TX1 — Idempotência
group TX1 · Idempotência (TransactionTemplate)
  ORDERS -> PG : INSERT idempotency_keys\nstatus=PROCESSING · expires_at=now+30s\nON CONFLICT DO NOTHING
  activate PG
  PG --> ORDERS : inserted=true (ganhou a corrida)\nou inserted=false (duplicata)
  deactivate PG

  alt Chave duplicada — mesmo hash
    ORDERS --> GW  : 201 (resposta cacheada)
    GW      --> PARTNER : 201 OK (idempotente)
    note right of ORDERS : Retorna resultado\ndo pedido original
  else Chave duplicada — hash diferente
    ORDERS --> GW  : 422 Unprocessable Entity
    GW      --> PARTNER : 422 (payload alterado\npara mesma chave)
  end
end

' TX2 — Negócio
group TX2 · Lógica de Negócio (TransactionTemplate)
  ORDERS -> PG : SELECT * FROM partner_credit\nWHERE partner_id = ?\nFOR UPDATE
  activate PG
  PG --> ORDERS : saldo disponível
  deactivate PG

  alt Crédito insuficiente
    ORDERS -> PG : UPDATE idempotency_keys\nstatus=DONE · response_status=422
    ORDERS --> GW : 422 Crédito insuficiente
    GW --> PARTNER : 422 Insufficient Credit
  else Crédito aprovado
    ORDERS -> PG : UPDATE partner_credit\navailable_credit -= total
    ORDERS -> PG : INSERT orders + order_items\nstatus=PENDENTE
    ORDERS -> PG : INSERT outbox_events\nstatus=PENDING · event_type=ORDER_CREATED
    ORDERS -> PG : UPDATE idempotency_keys\nstatus=DONE · order_id=? · response_status=201
    PG --> ORDERS : commit TX2
    deactivate PG
    ORDERS --> GW : 201 Created { id, status: PENDENTE, total }
    GW --> PARTNER : 201 Created
  end
end

deactivate ORDERS
deactivate GW

' ════════════════════════════════════
'  FLUXO 3 — OUTBOX RELAY (async)
' ════════════════════════════════════
== Fluxo 3 · Outbox Relay (assíncrono · @Scheduled 1s) ==

loop a cada 1 segundo — batch de 50 eventos
  ORDERS -> PG : SELECT * FROM outbox_events\nWHERE status='PENDING'\nAND next_attempt_at <= NOW()\nFOR UPDATE SKIP LOCKED\nLIMIT 50
  activate PG
  PG --> ORDERS : lista de eventos pendentes
  deactivate PG

  ORDERS -> KAFKA : kafkaTemplate.send(topic, key, payload)\n.get(5, SECONDS)   ← síncrono
  activate KAFKA

  alt Kafka ACK OK
    KAFKA --> ORDERS : ack
    ORDERS -> PG : UPDATE outbox_events\nstatus=SENT
    note right of ORDERS
      publishEvent(KafkaConfirmedEvent)
      → KafkaSseService recebe via @EventListener
      → transmite para browsers conectados
    end note
  else Kafka FALHOU
    KAFKA --> ORDERS : timeout / erro
    note right of ORDERS
      retry_count++
      next_attempt_at = now + 30s × 2^retry
      Se retry_count >= 5 → status=FAILED
      log.error → alerta
    end note
    ORDERS -> PG : UPDATE outbox_events\nnext_attempt_at · retry_count\n[PENDING ou FAILED]
  end

  deactivate KAFKA
end

' ════════════════════════════════════
'  FLUXO 4 — CONSUMIDORES KAFKA
' ════════════════════════════════════
== Fluxo 4 · Consumidores de Eventos (futuros) ==

KAFKA -> NOTIFY : order.events.order_created\n{ orderId, partnerId, total, status }
activate NOTIFY
note right of NOTIFY
  Envia e-mail / push / webhook
  para o parceiro
end note
NOTIFY --> KAFKA : commit offset
deactivate NOTIFY

' ════════════════════════════════════
'  FLUXO SSE PEDIDOS — DASHBOARD
' ════════════════════════════════════
== Fluxo SSE Pedidos · Dashboard Tempo Real ==

BROWSER -> GW : GET /api/v1/orders/stream\nAccept: text/event-stream
activate GW
GW -> ORDERS : proxy HTTP/1.1 sem buffer
activate ORDERS
note right of ORDERS
  SseEmitter registrado no pool
  (OrderSseService)
  Disparo: @TransactionalEventListener
  phase=AFTER_COMMIT — não interfere
  na transação de negócio
end note
ORDERS --> GW : 200 text/event-stream\n(conexão mantida aberta)
GW --> BROWSER : stream aberto

... pedido novo ou status atualizado ...

ORDERS -> BROWSER : event: order\ndata: { id, parceiro, status, total }
note right of BROWSER
  Aba "Histórico de Pedidos"
  linha aparece em verde em tempo real
end note

' ════════════════════════════════════
'  FLUXO SSE KAFKA — DASHBOARD
' ════════════════════════════════════
== Fluxo SSE Kafka · Dashboard Eventos Confirmados ==

BROWSER -> GW : GET /api/v1/orders/kafka/stream\nAccept: text/event-stream
activate GW
GW -> ORDERS : proxy HTTP/1.1 sem buffer
activate ORDERS
note right of ORDERS
  KafkaSseService
  Recebe KafkaConfirmedEvent via @EventListener
  após OutboxPublisher confirmar Kafka ACK
  Mantém histórico: últimos 20 eventos
  Novos subscribers recebem o histórico
  do mais antigo ao mais novo (prepend inverte)
end note
ORDERS --> GW : 200 text/event-stream\n(conexão mantida aberta)
GW --> BROWSER : stream aberto

... OutboxPublisher confirma envio ao Kafka ...

ORDERS -> BROWSER : event: kafka\ndata: { topic, orderId, partnerId, status, receivedAt }
note right of BROWSER
  Aba "Eventos Kafka"
  mostra confirmação real de que
  o Kafka recebeu o evento
end note

' ════════════════════════════════════
'  FLUXO 5 — ATUALIZAR STATUS
' ════════════════════════════════════
== Fluxo 5 · Atualizar Status do Pedido ==

PARTNER -> GW : PATCH /api/v1/orders/{id}/status\nBody: { status: "APROVADO" }
activate GW
GW -> ORDERS : roteia
activate ORDERS

alt Status inválido (ex: "APROVADOX")
  ORDERS --> GW : 400 Bad Request\n{ detail: "Requisição inválida: Cannot deserialize..." }
  GW --> PARTNER : 400
else Status válido
  ORDERS -> PG : SELECT * FROM orders WHERE id = ?
  activate PG
  PG --> ORDERS : Order { status: PENDENTE }
  deactivate PG

  note right of ORDERS
    Máquina de estados:
    PENDENTE → APROVADO ✓
    APROVADO → EM_PROCESSAMENTO
    EM_PROCESSAMENTO → ENVIADO
    ENVIADO → ENTREGUE
    * → CANCELADO (libera crédito)
  end note

  alt Transição válida
    ORDERS -> PG : UPDATE orders SET status=APROVADO
    ORDERS -> PG : INSERT outbox_events (ORDER_APPROVED)
    PG --> ORDERS : OK
    ORDERS --> GW : 200 OK { id, status: APROVADO }
    GW --> PARTNER : 200 OK
  else Transição inválida
    ORDERS --> GW : 422 Transição inválida
    GW --> PARTNER : 422
  end
end

deactivate ORDERS
deactivate GW

' ════════════════════════════════════
'  FLUXO 6 — CANCELAMENTO
' ════════════════════════════════════
== Fluxo 6 · Cancelamento com Estorno de Crédito ==

PARTNER -> GW : DELETE /api/v1/orders/{id}
activate GW
GW -> ORDERS : roteia
activate ORDERS

ORDERS -> PG : SELECT * FROM orders WHERE id = ?
activate PG
PG --> ORDERS : Order { status: APROVADO, total: R$500 }
deactivate PG

note right of ORDERS
  isCreditDebitable() = true
  (status era APROVADO)
  → crédito foi debitado → deve estornar
end note

ORDERS -> PG : UPDATE orders SET status=CANCELADO
ORDERS -> PG : UPDATE partner_credit\navailable_credit += R$500 (estorno)
ORDERS -> PG : INSERT outbox_events (ORDER_CANCELLED)
PG --> ORDERS : commit
deactivate PG

ORDERS --> GW  : 200 OK { status: CANCELADO }
GW --> PARTNER : 200 OK

deactivate ORDERS
deactivate GW

@enduml
